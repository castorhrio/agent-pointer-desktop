<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Str.AppSubtitle">bigarrow for the Windows desktop</sys:String>
    <sys:String x:Key="Str.HeroTitle">When your AI needs your hand, see exactly where to act.</sys:String>
    <sys:String x:Key="Str.HeroDescription">Approvals, verification codes, and hands-on steps: your agent finds the spot, the arrow explains the action, and you decide.</sys:String>
    <sys:String x:Key="Str.StepExperience">01  Try a guided step</sys:String>
    <sys:String x:Key="Str.ExperienceDescription">Start the demo. An arrow will point at the button on the right and disappear when you complete the step.</sys:String>
    <sys:String x:Key="Str.StartDemo">Try the demo</sys:String>
    <sys:String x:Key="Str.LanguageSystem">System default</sys:String>
    <sys:String x:Key="Str.StopDemo">End demo</sys:String>
    <sys:String x:Key="Str.DemoBadge">LOCAL DEMO · NO REAL TASK</sys:String>
    <sys:String x:Key="Str.DemoTitle">This is what a handoff looks like</sys:String>
    <sys:String x:Key="Str.DemoDescription">In a real task, the arrow appears over the app you are using and explains the action and its purpose.</sys:String>
    <sys:String x:Key="Str.DemoTask">Demo step: confirm you have seen the guide</sys:String>
    <sys:String x:Key="Str.DemoTarget">Complete this step</sys:String>
    <sys:String x:Key="Str.DemoInstruction">Click “Complete this step” to finish this demo</sys:String>
    <sys:String x:Key="Str.DemoIdle">Start the demo on the left. This button only completes the demo; it grants no permissions and sends nothing.</sys:String>
    <sys:String x:Key="Str.DemoStarting">Showing the guide…</sys:String>
    <sys:String x:Key="Str.DemoVisible">The guide is visible. Click the button above to finish the step.</sys:String>
    <sys:String x:Key="Str.DemoCompleted">Done! You have completed the handoff: see the guide, act, and watch it disappear.</sys:String>
    <sys:String x:Key="Str.DemoEnded">The demo has ended. You can try it again anytime.</sys:String>
    <sys:String x:Key="Str.DemoInterrupted">The window moved or lost focus, so the demo ended. Try again to locate the button afresh.</sys:String>
    <sys:String x:Key="Str.StepSetup">02  Teach your agent to point</sys:String>
    <sys:String x:Key="Str.SetupDescription">Install the skill so Claude Code and Codex know when and how to show a guide.</sys:String>
    <sys:String x:Key="Str.InstallSkills">Install / update agent skills</sys:String>
    <sys:String x:Key="Str.StatusChecking">Checking…</sys:String>
    <sys:String x:Key="Str.StatusInstalled">Skill installed</sys:String>
    <sys:String x:Key="Str.StatusMissing">Not installed</sys:String>
    <sys:String x:Key="Str.StatusOutdated">Update needed</sys:String>
    <sys:String x:Key="Str.StatusUnavailable">Unavailable</sys:String>
    <sys:String x:Key="Str.InstallingSkills">Installing skills…</sys:String>
    <sys:String x:Key="Str.SkillsInstalled">Restart an agent whose skill is installed, then try the prompt below.</sys:String>
    <sys:String x:Key="Str.SetupHint">Set up once. Reinstall here after moving or updating the app.</sys:String>
    <sys:String x:Key="Str.StepTryAgent">03  Try it in your agent conversation</sys:String>
    <sys:String x:Key="Str.TryAgentDescription">After installing the skill, restart Claude Code or Codex and paste this prompt. In your next task, ask your agent to point when it needs your hand.</sys:String>
    <sys:String x:Key="Str.CopyPrompt">Copy a test prompt</sys:String>
    <sys:String x:Key="Str.PromptCopied">Prompt copied. Paste it into a new agent conversation.</sys:String>
    <sys:String x:Key="Str.AgentPrompt">Use the $agentpointer skill to show a guide at the current mouse position for 10 seconds, labeled “This is a guide from your AI assistant.”</sys:String>
    <sys:String x:Key="Str.More">Details and diagnostics</sys:String>
    <sys:String x:Key="Str.ScopeNote">Claude Code or Codex initiates guides during your task. This desktop app handles setup and the demo; it does not read conversations. An installed skill does not mean an agent is running.</sys:String>
    <sys:String x:Key="Str.Limitations">Window, mouse, and screen-coordinate targeting are supported. Finding controls by name, following windows, and speech are not implemented yet.</sys:String>
    <sys:String x:Key="Str.ComponentReady">Screen guide component available · v{0}</sys:String>
    <sys:String x:Key="Str.ComponentMissing">The guide component is missing. Reinstall the complete desktop package.</sys:String>
    <sys:String x:Key="Str.ComponentFailed">The guide component could not start. Reinstall the complete package.</sys:String>
    <sys:String x:Key="Str.Refresh">Check again</sys:String>
    <sys:String x:Key="Str.CopyDoctor">Copy diagnostic command</sys:String>
    <sys:String x:Key="Str.DoctorCopied">Diagnostic command copied. Run it in PowerShell.</sys:String>
    <sys:String x:Key="Str.EnvFormat">{0} display(s) · primary {1}×{2} · scale {3}%</sys:String>
    <sys:String x:Key="Str.Attribution">Based on bigarrow by Franz Enzenhofer, under the MIT license. Attribution and licenses are included in the package.</sys:String>
    <sys:String x:Key="Str.TrayHint">Closing this window keeps the app in the tray. Exit from the tray menu.</sys:String>
    <sys:String x:Key="Str.ActionFailed">Could not complete the action: {0}</sys:String>
    <sys:String x:Key="Str.ClipboardFailed">The clipboard is unavailable. Please try again.</sys:String>
    <sys:String x:Key="Str.CheckUpdate">Check for updates</sys:String>
    <sys:String x:Key="Str.Checking">Checking for updates…</sys:String>
    <sys:String x:Key="Str.UpToDate">You are up to date</sys:String>
    <sys:String x:Key="Str.NewVersion">New version v{0} available</sys:String>
    <sys:String x:Key="Str.UpdateFailed">Could not check for updates</sys:String>
    <sys:String x:Key="Str.UpdateNotConfigured">Updates are not configured yet. Use a newer package provided by the maintainer.</sys:String>
    <sys:String x:Key="Str.CopyLink">Copy release link</sys:String>
    <sys:String x:Key="Str.TrayOpen">Open Agent Pointer</sys:String>
    <sys:String x:Key="Str.TrayLanguage">Language</sys:String>
    <sys:String x:Key="Str.TrayExit">Exit app</sys:String>
</ResourceDictionary>
