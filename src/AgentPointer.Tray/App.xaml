<Application x:Class="AgentPointer.Tray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- 设计 token：与箭头覆盖层同一套语言（红 #DC1E1E 强调、深底、白描边意象）。
             改这里即改整个托盘应用的观感，不要在页面里写散落的颜色。 -->
        <Color x:Key="ColBg">#16171C</Color>
        <Color x:Key="ColSurface">#1F2128</Color>
        <Color x:Key="ColSurfaceHi">#262A33</Color>
        <Color x:Key="ColBorder">#2E323D</Color>
        <Color x:Key="ColText">#ECEDEF</Color>
        <Color x:Key="ColTextDim">#9CA0AB</Color>
        <Color x:Key="ColAccent">#DC1E1E</Color>
        <Color x:Key="ColOk">#3BC26A</Color>

        <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColBg}" />
        <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColSurface}" />
        <SolidColorBrush x:Key="BrushSurfaceHi" Color="{StaticResource ColSurfaceHi}" />
        <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColBorder}" />
        <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColText}" />
        <SolidColorBrush x:Key="BrushTextDim" Color="{StaticResource ColTextDim}" />
        <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColAccent}" />
        <SolidColorBrush x:Key="BrushOk" Color="{StaticResource ColOk}" />

        <FontFamily x:Key="FontUi">Segoe UI</FontFamily>

        <!-- 卡片：内容的最小容器。统一圆角与内边距，不再各自为政。 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextDim}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        </Style>

        <Style x:Key="DimText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Foreground" Value="{StaticResource BrushTextDim}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- 命令行：等宽、深一层的底色，与正文区分。 -->
        <Style x:Key="CommandLine" TargetType="Border">
            <Setter Property="Background" Value="#101116" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style x:Key="CommandText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#D8DEE9" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 次要按钮：描边式，hover 提亮。唯一的强调色留给品牌箭头。 -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSurfaceHi}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3C414E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="#D54C43" />
            <Setter Property="BorderBrush" Value="#E2645C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,9" />
        </Style>
    </Application.Resources>
</Application>
