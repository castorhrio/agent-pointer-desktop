<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Str.AppSubtitle">bigarrow 的 Windows 桌面版</sys:String>
    <sys:String x:Key="Str.HeroTitle">AI 做到需要你动手的那一步，直接指给你看。</sys:String>
    <sys:String x:Key="Str.HeroDescription">授权、输入验证码、完成一个操作步骤：由 agent 找到位置，箭头说明该做什么，你来决定并完成操作。</sys:String>
    <sys:String x:Key="Str.StepExperience">01  先体验一次指引</sys:String>
    <sys:String x:Key="Str.ExperienceDescription">点击下方按钮，箭头会指向右侧的演示按钮。完成这一步后，指引会收起。</sys:String>
    <sys:String x:Key="Str.StartDemo">体验屏幕指引</sys:String>
    <sys:String x:Key="Str.StopDemo">结束体验</sys:String>
    <sys:String x:Key="Str.DemoBadge">本地演示 · 不执行实际任务</sys:String>
    <sys:String x:Key="Str.DemoTitle">这就是 agent 请你接手时的样子</sys:String>
    <sys:String x:Key="Str.DemoDescription">实际使用时，指引会出现在你正在操作的应用上，并说明动作与用途。</sys:String>
    <sys:String x:Key="Str.DemoTask">演示步骤：确认你已经看到指引</sys:String>
    <sys:String x:Key="Str.DemoTarget">完成这一步</sys:String>
    <sys:String x:Key="Str.DemoInstruction">请点击「完成这一步」，结束本次体验</sys:String>
    <sys:String x:Key="Str.DemoIdle">先点击左侧「体验屏幕指引」。此按钮仅用于演示，不会批准、安装或发送任何内容。</sys:String>
    <sys:String x:Key="Str.DemoStarting">正在显示指引…</sys:String>
    <sys:String x:Key="Str.DemoVisible">指引已显示。点击上方按钮，完成这一步。</sys:String>
    <sys:String x:Key="Str.DemoCompleted">体验完成！你已走过「看到指引 → 完成人工操作 → 指引收起」的流程。</sys:String>
    <sys:String x:Key="Str.DemoEnded">体验已结束。你可以随时再试一次。</sys:String>
    <sys:String x:Key="Str.DemoInterrupted">窗口已移动或切换，体验已结束。重新体验会再次定位按钮。</sys:String>
    <sys:String x:Key="Str.StepSetup">02  让你的 agent 学会使用它</sys:String>
    <sys:String x:Key="Str.SetupDescription">安装使用技能，让 Claude Code 和 Codex 知道何时、如何显示屏幕指引。</sys:String>
    <sys:String x:Key="Str.InstallSkills">安装 / 更新 agent 技能</sys:String>
    <sys:String x:Key="Str.StatusChecking">检查中…</sys:String>
    <sys:String x:Key="Str.StatusInstalled">技能已安装</sys:String>
    <sys:String x:Key="Str.StatusMissing">尚未安装</sys:String>
    <sys:String x:Key="Str.StatusOutdated">需要更新</sys:String>
    <sys:String x:Key="Str.StatusUnavailable">暂时无法检查</sys:String>
    <sys:String x:Key="Str.InstallingSkills">正在安装技能…</sys:String>
    <sys:String x:Key="Str.SkillsInstalled">已配置技能的 agent 可在重启后使用。复制下方提示词试用。</sys:String>
    <sys:String x:Key="Str.SetupHint">技能只需配置一次；移动或更新应用后可在这里重新安装。</sys:String>
    <sys:String x:Key="Str.StepTryAgent">03  回到 agent 对话里试用</sys:String>
    <sys:String x:Key="Str.TryAgentDescription">安装技能后，重启 Claude Code 或 Codex，粘贴这段提示词。之后继续描述你的任务，需要你动手时让 agent 发起指引。</sys:String>
    <sys:String x:Key="Str.CopyPrompt">复制试用提示词</sys:String>
    <sys:String x:Key="Str.PromptCopied">提示词已复制，请粘贴到新的 agent 会话。</sys:String>
    <sys:String x:Key="Str.AgentPrompt">请使用 $agentpointer 技能，在当前鼠标位置显示一条屏幕指引，文字为「这是一条来自 AI 助手的指引」，持续 10 秒。</sys:String>
    <sys:String x:Key="Str.More">使用说明与诊断</sys:String>
    <sys:String x:Key="Str.ScopeNote">由 Claude Code 或 Codex 根据任务发起指引。桌面应用负责接入配置和体验，不会读取或监控你的对话；技能已安装不代表 agent 正在运行。</sys:String>
    <sys:String x:Key="Str.Limitations">当前支持窗口、鼠标和屏幕坐标定位。按控件名称自动查找、跟随窗口和语音提示尚未实现。</sys:String>
    <sys:String x:Key="Str.ComponentReady">屏幕指引组件可用 · v{0}</sys:String>
    <sys:String x:Key="Str.ComponentMissing">缺少屏幕指引组件，请重新安装包含桌面应用的完整安装包。</sys:String>
    <sys:String x:Key="Str.ComponentFailed">屏幕指引组件无法启动，请重新安装完整安装包。</sys:String>
    <sys:String x:Key="Str.Refresh">重新检查</sys:String>
    <sys:String x:Key="Str.CopyDoctor">复制诊断命令</sys:String>
    <sys:String x:Key="Str.DoctorCopied">诊断命令已复制，可在 PowerShell 中运行。</sys:String>
    <sys:String x:Key="Str.EnvFormat">显示器 {0} 块 · 主屏 {1}×{2} · 显示缩放 {3}%</sys:String>
    <sys:String x:Key="Str.Attribution">基于 Franz Enzenhofer 的 bigarrow，采用 MIT 许可。原作者版权与许可随安装包提供。</sys:String>
    <sys:String x:Key="Str.TrayHint">关闭窗口后保留在托盘；可从托盘菜单退出。</sys:String>
    <sys:String x:Key="Str.ActionFailed">未能完成：{0}</sys:String>
    <sys:String x:Key="Str.ClipboardFailed">剪贴板暂不可用，请稍后再试。</sys:String>
    <sys:String x:Key="Str.CheckUpdate">检查更新</sys:String>
    <sys:String x:Key="Str.Checking">正在检查更新…</sys:String>
    <sys:String x:Key="Str.UpToDate">已是最新版本</sys:String>
    <sys:String x:Key="Str.NewVersion">有新版本 v{0}</sys:String>
    <sys:String x:Key="Str.UpdateFailed">暂时无法检查更新</sys:String>
    <sys:String x:Key="Str.UpdateNotConfigured">更新源尚未配置，请使用维护者提供的新版安装包。</sys:String>
    <sys:String x:Key="Str.CopyLink">复制发布链接</sys:String>
    <sys:String x:Key="Str.TrayOpen">打开 Agent Pointer</sys:String>
    <sys:String x:Key="Str.TrayLanguage">语言</sys:String>
    <sys:String x:Key="Str.TrayExit">退出应用</sys:String>
</ResourceDictionary>
