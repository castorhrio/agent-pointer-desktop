<Window x:Class="AgentPointer.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Pointer for Windows"
        Width="820" SizeToContent="Height" MinHeight="560"
        ResizeMode="CanMinimize" ShowInTaskbar="True" ShowActivated="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}" Foreground="{StaticResource BrushText}"
        FontFamily="{StaticResource FontUi}" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" Background="#302025" CornerRadius="12" Margin="0,0,12,0">
                    <Path Data="M 10,31 C 15,25 21,20 29,13 M 20,12 L 31,11 L 30,22"
                          Stroke="#FF665C" StrokeThickness="3" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="2" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Agent Pointer" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Str.AppSubtitle}" FontSize="11"
                               Foreground="{StaticResource BrushTextDim}" Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="LanguageButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                        AutomationProperties.AutomationId="Language"
                        VerticalAlignment="Center" Click="OnLanguageMenu" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,24,0,20">
                <TextBlock Text="{DynamicResource Str.HeroTitle}" FontSize="27" FontWeight="SemiBold"
                           TextWrapping="Wrap" LineHeight="36" />
                <TextBlock Text="{DynamicResource Str.HeroDescription}" Style="{StaticResource DimText}"
                           TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0" />
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.StepExperience}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{DynamicResource Str.ExperienceDescription}" Style="{StaticResource DimText}"
                                       TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14" />
                            <WrapPanel>
                                <Button x:Name="StartDemoButton" AutomationProperties.AutomationId="StartDemo"
                                        Content="{DynamicResource Str.StartDemo}" Style="{StaticResource PrimaryButton}"
                                        Click="OnStartDemo" IsEnabled="False" />
                                <Button x:Name="StopDemoButton" Content="{DynamicResource Str.StopDemo}"
                                        Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Click="OnStopDemo" Visibility="Collapsed" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.StepSetup}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{DynamicResource Str.SetupDescription}" Style="{StaticResource DimText}"
                                       TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Claude Code" Style="{StaticResource BodyText}" />
                                <TextBlock x:Name="ClaudeStatus" Text="{DynamicResource Str.StatusChecking}"
                                           Style="{StaticResource DimText}" HorizontalAlignment="Right"
                                           AutomationProperties.AutomationId="ClaudeSkillStatus" />
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Codex" Style="{StaticResource BodyText}" />
                                <TextBlock x:Name="CodexStatus" Text="{DynamicResource Str.StatusChecking}"
                                           Style="{StaticResource DimText}" HorizontalAlignment="Right"
                                           AutomationProperties.AutomationId="CodexSkillStatus" />
                            </Grid>
                            <Button x:Name="InstallSkillsButton" AutomationProperties.AutomationId="InstallSkills"
                                    Content="{DynamicResource Str.InstallSkills}" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Click="OnInstallSkills" IsEnabled="False" />
                            <TextBlock x:Name="SetupResult" Style="{StaticResource DimText}" TextWrapping="Wrap"
                                       LineHeight="19" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Background="#181F29" BorderBrush="#344153" BorderThickness="1"
                        CornerRadius="12" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.DemoBadge}" Foreground="#A8C6EE"
                                       FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Str.DemoTitle}" FontSize="21" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,14,0,10" />
                            <TextBlock Text="{DynamicResource Str.DemoDescription}" Style="{StaticResource DimText}"
                                       TextWrapping="Wrap" LineHeight="21" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,22">
                            <TextBlock Text="{DynamicResource Str.DemoTask}" FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,12" />
                            <Button x:Name="DemoTargetButton" AutomationProperties.AutomationId="DemoTarget"
                                    Content="{DynamicResource Str.DemoTarget}" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Right" MinWidth="156" Padding="16,12"
                                    IsEnabled="False" Click="OnCompleteDemo" />
                        </StackPanel>
                        <TextBlock x:Name="DemoStatus" Grid.Row="2" Text="{DynamicResource Str.DemoIdle}"
                                   AutomationProperties.AutomationId="DemoStatus"
                                   Style="{StaticResource DimText}" TextWrapping="Wrap" LineHeight="20" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="{DynamicResource Str.StepTryAgent}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{DynamicResource Str.TryAgentDescription}" Style="{StaticResource DimText}"
                                   TextWrapping="Wrap" LineHeight="20" />
                    </StackPanel>
                    <Button x:Name="CopyPromptButton" Grid.Column="1" Content="{DynamicResource Str.CopyPrompt}"
                            Style="{StaticResource GhostButton}" Click="OnCopyPrompt" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Expander Grid.Row="4" Header="{DynamicResource Str.More}" Margin="0,16,0,0"
                      Foreground="{StaticResource BrushTextDim}" FontSize="12">
                <StackPanel Margin="4,12,0,0">
                    <TextBlock Text="{DynamicResource Str.ScopeNote}" Style="{StaticResource DimText}"
                               TextWrapping="Wrap" LineHeight="20" />
                    <TextBlock Text="{DynamicResource Str.Limitations}" Style="{StaticResource DimText}"
                               TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0" />
                    <TextBlock x:Name="EnvironmentText" Style="{StaticResource DimText}" Margin="0,10,0,0" />
                    <TextBlock x:Name="ComponentStatus" AutomationProperties.AutomationId="ComponentStatus"
                               Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="RefreshButton" Content="{DynamicResource Str.Refresh}"
                                Style="{StaticResource GhostButton}" Click="OnRefresh" />
                        <Button Content="{DynamicResource Str.CopyDoctor}" Style="{StaticResource GhostButton}"
                                Click="OnCopyDoctor" Margin="8,0,0,0" />
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource Str.Attribution}" Style="{StaticResource DimText}"
                               TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Expander>

            <Grid Grid.Row="5" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str.TrayHint}" Style="{StaticResource DimText}"
                               FontSize="11" TextWrapping="Wrap" />
                    <TextBlock x:Name="UpdateStatus" Visibility="Collapsed" Style="{StaticResource DimText}"
                               TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="{Binding VersionLabel}" Foreground="{StaticResource BrushTextDim}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="CheckUpdateButton" Content="{DynamicResource Str.CheckUpdate}"
                            Style="{StaticResource GhostButton}" Click="OnCheckUpdate" ToolTipService.ShowOnDisabled="True" />
                    <Button x:Name="CopyLinkButton" Content="{DynamicResource Str.CopyLink}"
                            Style="{StaticResource GhostButton}" Click="OnCopyReleaseLink"
                            Margin="8,0,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
